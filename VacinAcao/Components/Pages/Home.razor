@page "/"

<PageTitle>VacinAção | Saúde na palma da mão</PageTitle>

<div class="vacina-app">

    <!-- HERO -->

    <section class="hero">

        <div class="hero-container">

            <div class="hero-text">

                <div class="badge">
                    <span>●</span>
                    Saúde pública inteligente
                </div>

                <h1>
                    Sua vacinação,
                    <strong>mais simples.</strong>
                </h1>

                <p>
                    Consulte seu histórico vacinal, acompanhe suas próximas
                    doses e agende atendimentos de forma rápida e segura.
                </p>

                <div class="hero-buttons">

                    <a href="/login" class="btn-primary">
                        Entrar na minha conta
                        <span>→</span>
                    </a>

                    <a href="/cadastro" class="btn-secondary">
                        Criar minha conta
                    </a>

                </div>

                <div class="security">
                    <span>✓</span>
                    Seus dados são tratados com segurança
                </div>

            </div>


            <!-- CARD ILUSTRATIVO -->

            <div class="hero-card">

                <div class="card-header">

                    <div>
                        <small>PRÓXIMA VACINA</small>
                        <h3>Calendário vacinal</h3>
                    </div>

                    <div class="card-icon">
                        💉
                    </div>

                </div>

                <div class="vaccine-status">

                    <div class="status-icon">
                        ✓
                    </div>

                    <div>
                        <strong>Vacinação em dia</strong>
                        <p>Nenhuma dose pendente</p>
                    </div>

                </div>

                <div class="progress-area">

                    <div class="progress-info">
                        <span>Seu calendário</span>
                        <strong>85%</strong>
                    </div>

                    <div class="progress">
                        <div class="progress-value"></div>
                    </div>

                </div>

                <div class="next-dose">

                    <div class="calendar-icon">
                        📅
                    </div>

                    <div>
                        <small>PRÓXIMO LEMBRETE</small>
                        <strong>Acompanhe suas doses</strong>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- RECURSOS -->

    <section class="features">

        <div class="section-title">

            <span>VacinAção</span>

            <h2>
                Tudo o que você precisa
                <br />
                em um só lugar.
            </h2>

            <p>
                Uma plataforma criada para facilitar o acompanhamento
                da vacinação e melhorar o acesso aos serviços de saúde.
            </p>

        </div>


        <div class="feature-grid">

            <div class="feature-card">

                <div class="feature-icon blue">
                    💉
                </div>

                <h3>Histórico Vacinal</h3>

                <p>
                    Consulte suas vacinas, doses aplicadas e informações
                    importantes do seu histórico.
                </p>

                <a href="/login">
                    Ver histórico →
                </a>

            </div>


            <div class="feature-card">

                <div class="feature-icon green">
                    📅
                </div>

                <h3>Calendário Inteligente</h3>

                <p>
                    Saiba quais são as próximas doses e receba lembretes
                    para não perder nenhuma vacinação.
                </p>

                <a href="/login">
                    Ver calendário →
                </a>

            </div>


            <div class="feature-card">

                <div class="feature-icon purple">
                    🏥
                </div>

                <h3>Agendamento</h3>

                <p>
                    Encontre uma unidade de saúde e agende seu atendimento
                    de maneira simples.
                </p>

                <a href="/login">
                    Agendar atendimento →
                </a>

            </div>

        </div>

    </section>


    <!-- CHAMADA FINAL -->

    <section class="cta">

        <div>

            <span>VACINAÇÃO PARA TODOS</span>

            <h2>
                Cuide da sua saúde.
                <br />
                Mantenha suas vacinas em dia.
            </h2>

            <p>
                Crie sua conta gratuitamente e comece a acompanhar
                sua vacinação.
            </p>

        </div>

        <a href="/cadastro" class="cta-button">
            Começar agora →
        </a>

    </section>


    <!-- FOOTER -->

    <footer>

        <div class="footer-logo">
            <span>✚</span>
            VacinAção
        </div>

        <p>
            Tecnologia a serviço da saúde pública.
        </p>

        <span class="copyright">
            © 2026 VacinAção
        </span>

    </footer>

</div>