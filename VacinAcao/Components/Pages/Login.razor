
@page "/login"

<PageTitle>Entrar | VacinAção</PageTitle>

<div class="login-page">

    <div class="login-container">

        <div class="login-logo">
            <span>✚</span>
            <strong>VacinAção</strong>
        </div>

        <div class="login-header">
            <h1>Bem-vindo de volta!</h1>

            <p>
                Entre na sua conta para acompanhar
                sua vacinação.
            </p>
        </div>

        <div class="formulario">

            <div class="campo">
                <label>E-mail</label>

                <input type="email"
                       placeholder="seu@email.com" />
            </div>

            <div class="campo">
                <label>Senha</label>

                <input type="password"
                       placeholder="Digite sua senha" />
            </div>

            <div class="opcoes">

                <label class="lembrar">
                    <input type="checkbox" />
                    Lembrar de mim
                </label>

                <a href="#">
                    Esqueci minha senha
                </a>

            </div>

            <button class="btn-entrar">
                Entrar na minha conta
            </button>

        </div>

        <div class="cadastro-link">
            Ainda não possui uma conta?
            <a href="/cadastro">Criar minha conta</a>
        </div>

        <div class="voltar-home">
            <a href="/">← Voltar para o início</a>
        </div>

    </div>

</div>

<style>

    .login-page {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .login-container {
        width: 100%;
        max-width: 450px;
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.10);
    }

    .login-logo {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        font-size: 24px;
        color: #0d6efd;
        margin-bottom: 30px;
    }

    .login-logo span {
        font-size: 30px;
    }

    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-header h1 {
        margin-bottom: 10px;
    }

    .login-header p {
        color: #666;
        margin: 0;
    }

    .campo {
        margin-bottom: 20px;
    }

    .campo label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .campo input[type="email"],
    .campo input[type="password"] {
        width: 100%;
        padding: 13px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 15px;
        box-sizing: border-box;
    }

    .opcoes {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        font-size: 14px;
    }

    .lembrar {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .opcoes a {
        color: #0d6efd;
        text-decoration: none;
    }

    .btn-entrar {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 10px;
        background: #0d6efd;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-entrar:hover {
        background: #0b5ed7;
    }

    .cadastro-link {
        text-align: center;
        margin-top: 25px;
        color: #666;
    }

    .cadastro-link a {
        color: #0d6efd;
        text-decoration: none;
        font-weight: 600;
    }

    .voltar-home {
        text-align: center;
        margin-top: 20px;
    }

    .voltar-home a {
        color: #666;
        text-decoration: none;
    }

</style>

