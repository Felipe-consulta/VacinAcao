@page "/login"
@rendermode InteractiveServer

@using VacinAcao.Models
@using Microsoft.EntityFrameworkCore
@inject VacinAcao.AppDbContext Db
@inject NavigationManager Navigation

<PageTitle>Entrar | VacinAção</PageTitle>

<div class="login-page">

    <div class="login-container">

        <div class="login-logo">
            <span>✚</span>
            <strong>VacinAção</strong>
        </div>

        <div class="login-header">
            <h1>Bem-vindo de volta!</h1>

            <p>
                Entre na sua conta para acompanhar
                sua vacinação.
            </p>
        </div>

        <div class="formulario">

            <div class="campo">
                <label>E-mail</label>

                <input @bind="email"
                       type="email"
                       placeholder="seu@email.com" />
            </div>

            <div class="campo">
                <label>Senha</label>

                <input @bind="senha"
                       type="password"
                       placeholder="Digite sua senha" />
            </div>

            <div class="opcoes">

                <label class="lembrar">
                    <input type="checkbox" @bind="lembrarDeMim" />
                    Lembrar de mim
                </label>

                <a href="#">
                    Esqueci minha senha
                </a>

            </div>

            @if (!string.IsNullOrEmpty(mensagem))
            {
                <div class="mensagem">
                    @mensagem
                </div>
            }

            <button class="btn-entrar" @onclick="Entrar">
                Entrar na minha conta
            </button>

        </div>

        <div class="cadastro-link">
            Ainda não possui uma conta?
            <a href="/cadastro">Criar minha conta</a>
        </div>

        <div class="voltar-home">
            <a href="/">← Voltar para o início</a>
        </div>

    </div>

</div>

<style>

    .login-page {
        min-height: 80vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .login-container {
        width: 100%;
        max-width: 450px;
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.10);
    }

    .login-logo {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 10px;
        font-size: 24px;
        color: #0d6efd;
        margin-bottom: 30px;
    }

    .login-logo span {
        font-size: 30px;
    }

    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .login-header h1 {
        margin-bottom: 10px;
    }

    .login-header p {
        color: #666;
        margin: 0;
    }

    .campo {
        margin-bottom: 20px;
    }

    .campo label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .campo input[type="email"],
    .campo input[type="password"] {
        width: 100%;
        padding: 13px;
        border: 1px solid #ddd;
        border-radius: 10px;
        font-size: 15px;
        box-sizing: border-box;
    }

    .campo input:focus {
        outline: none;
        border-color: #0d6efd;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.10);
    }

    .opcoes {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
        font-size: 14px;
    }

    .lembrar {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .opcoes a {
        color: #0d6efd;
        text-decoration: none;
    }

    .opcoes a:hover {
        text-decoration: underline;
    }

    .btn-entrar {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 10px;
        background: #0d6efd;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn-entrar:hover {
        background: #0b5ed7;
        transform: translateY(-1px);
    }

    .mensagem {
        background: #ffe5e5;
        color: #b00020;
        padding: 12px;
        border-radius: 10px;
        margin-bottom: 20px;
        text-align: center;
        font-size: 14px;
    }

    .cadastro-link {
        text-align: center;
        margin-top: 25px;
        color: #666;
    }

    .cadastro-link a {
        color: #0d6efd;
        text-decoration: none;
        font-weight: 600;
    }

    .voltar-home {
        text-align: center;
        margin-top: 20px;
    }

    .voltar-home a {
        color: #666;
        text-decoration: none;
    }

    .voltar-home a:hover {
        color: #0d6efd;
    }

</style>

@code {

    private string email = string.Empty;

    private string senha = string.Empty;

    private bool lembrarDeMim = false;

    private string mensagem = string.Empty;

    private async Task Entrar()
    {
        mensagem = string.Empty;

        if (string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(senha))
        {
            mensagem = "Digite seu e-mail e sua senha.";
            return;
        }

        var usuario = await Db.Usuarios
            .FirstOrDefaultAsync(u =>
                u.Email == email &&
                u.Senha == senha);

        if (usuario == null)
        {
            mensagem = "E-mail ou senha incorretos.";
            return;
        }

        Navigation.NavigateTo(
            $"/painel?email={Uri.EscapeDataString(usuario.Email)}"
        );
    }
}