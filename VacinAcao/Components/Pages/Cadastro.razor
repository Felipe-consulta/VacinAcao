@page "/cadastro"
@rendermode InteractiveServer

@using VacinAcao.Models
@using Microsoft.EntityFrameworkCore
@inject VacinAcao.AppDbContext Db
@inject NavigationManager Navigation

<PageTitle>Criar conta | VacinAção</PageTitle>

<div class="cadastro-page">

    <div class="cadastro-container">

        <div class="cadastro-logo">
            <span>✚</span>
            <strong>VacinAção</strong>
        </div>

        <div class="cadastro-header">
            <h1>Criar sua conta</h1>

            <p>
                Cadastre-se para acompanhar sua vacinação
                de forma simples e segura.
            </p>
        </div>

        <div class="formulario">

            <div class="campo">
                <label>Nome completo</label>
                <input @bind="usuario.NomeCompleto"
                       type="text"
                       placeholder="Digite seu nome completo" />
            </div>

            <div class="campo">
                <label>CPF</label>
                <input @bind="usuario.CPF"
                       type="text"
                       placeholder="Digite seu CPF" />
            </div>

            <div class="campo">
                <label>E-mail</label>
                <input @bind="usuario.Email"
                       type="email"
                       placeholder="seu@email.com" />
            </div>

            <div class="campo">
                <label>Senha</label>
                <input @bind="usuario.Senha"
                       type="password"
                       placeholder="Crie uma senha" />
            </div>

            <div class="campo">
                <label>Confirmar senha</label>
                <input @bind="confirmarSenha"
                       type="password"
                       placeholder="Digite a senha novamente" />
            </div>

            @if (!string.IsNullOrEmpty(mensagem))
            {
                <div class="mensagem">
                    @mensagem
                </div>
            }

            <button class="btn-cadastrar" @onclick="Cadastrar">
                Criar minha conta
            </button>

        </div>

        <div class="voltar">
            Já possui uma conta?
            <a href="/login">Entrar</a>
        </div>

        <div class="voltar-home">
            <a href="/">← Voltar para o início</a>
        </div>

    </div>

</div>

@code {

    private Usuario usuario = new();

    private string confirmarSenha = string.Empty;

    private string mensagem = string.Empty;

    private async Task Cadastrar()
    {
        mensagem = string.Empty;

        if (string.IsNullOrWhiteSpace(usuario.NomeCompleto) ||
            string.IsNullOrWhiteSpace(usuario.CPF) ||
            string.IsNullOrWhiteSpace(usuario.Email) ||
            string.IsNullOrWhiteSpace(usuario.Senha))
        {
            mensagem = "Preencha todos os campos.";
            return;
        }

        if (usuario.Senha != confirmarSenha)
        {
            mensagem = "As senhas não coincidem.";
            return;
        }

        var emailExiste = await Db.Usuarios
            .AnyAsync(u => u.Email == usuario.Email);

        if (emailExiste)
        {
            mensagem = "Este e-mail já está cadastrado.";
            return;
        }

        var cpfExiste = await Db.Usuarios
            .AnyAsync(u => u.CPF == usuario.CPF);

        if (cpfExiste)
        {
            mensagem = "Este CPF já está cadastrado.";
            return;
        }

        Db.Usuarios.Add(usuario);

        await Db.SaveChangesAsync();

        Navigation.NavigateTo("/login");
    }
}